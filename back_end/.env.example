# --- LLM ---
# Which backend powers the two agents: "openai" or "groq".
# Defaults to openai when OPENAI_API_KEY is set, otherwise groq.
#
#   openai - paid, but generous rate limits. A podcast is ~10-20k tokens, which
#            is well under a cent on gpt-4o-mini. The reliable choice.
#   groq   - free, but only 8k tokens/MINUTE and 200k/day, and an agent loop
#            burns through that fast. Expect 429s and failed jobs.
LLM_BACKEND=openai

# Set the key for whichever backend you chose.
OPENAI_API_KEY=
# GROQ_API_KEY=

# Google Search for the news researcher. Free tier: https://serper.dev
SERPER_API_KEY=

# --- Text to speech ---
# Without ELEVENLABS_API_KEY the app still runs and uses the free edge-tts voice.
# ElevenLabs free tier is ~10k characters/month, which is roughly 3 podcasts.
# The key must have the "text_to_speech" permission enabled.
ELEVENLABS_API_KEY=
# eleven_v3 performs inline audio tags like [laughs]. It does not support speed.
ELEVENLABS_MODEL_ID=eleven_v3
# List your voices with: GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_MALE=nPczCjzI2devNBz1zQrb
ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
# "elevenlabs" (default, falls back to edge-tts on quota errors) or "edge-tts".
TTS_PROVIDER=elevenlabs

# --- Optional ---
# Override the per-agent models. Defaults depend on LLM_BACKEND.
# RESEARCH_MODEL=gpt-4o-mini
# WRITER_MODEL=gpt-4o
# CORS_ORIGINS=http://localhost:3000
# Emails you when ElevenLabs credits run out. Omit to just log instead.
# RESEND_API_KEY=
# ALERT_EMAIL_TO=
